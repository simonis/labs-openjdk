# This file contains just enough from the original make/ide/vscode/hotspot/CreateVSCodeProject.gmk
# to create a VS Code workspace with ccls as indexer from the Shenandoah for SubstrateVM sources
# in this branch.

COMPILE_COMMANDS := $(BUILD_DIR)/compile_commands.json
override VSCODE := vscode_ccls

VSCODE_INDEXER := ccls

DOLLAR := $$
DQUOTE := "
#"
define NEWLINE


endef

FixPath = \
    $1

################################################################################
# SedEscape
#
# Escape special characters for use in SED replacement string
################################################################################
SedEscape = $(subst !,\!,$(subst \,\\,$1))

################################################################################
# Return the full path to an indexer-specific file fragment.
#
# Param 1: Fragment name
################################################################################
GetIndexerFragment = \
    $(PROJECT_ROOT)ide/vscode/hotspot/indexers/$(VSCODE_INDEXER)-$(1).txt

################################################################################
# Create a project configuration from a given template, replacing a known set
# of variables.
#
# Param 1: Template
# Param 2: Output
################################################################################
define CreateFromTemplate
	@echo Generating $2
	$(QUIETLY) sed -e '/{{INDEXER_EXTENSIONS}}/r $(call GetIndexerFragment,extensions)' \
	    -e '/{{INDEXER_SETTINGS}}/r $(call GetIndexerFragment,settings)' $1 | \
	sed -e 's!{{TOPDIR}}!$(call SedEscape,$(call FixPath,$(PROJECT_ROOT)))!g' \
	    -e 's!{{TOPDIR_RELATIVE}}!$(call SedEscape,$(call FixPath,$(BUILD_DIR)))!g' \
	    -e 's!{{WORKSPACE_ROOT}}!$(call SedEscape,$(call FixPath,$(WORKSPACE_ROOT)))!g' \
	    -e 's!{{OUTPUTDIR}}!$(call SedEscape,$(call FixPath,$(BUILD_DIR)))!g' \
	    -e 's!{{CONF_NAME}}!$(CONF_NAME)!g' \
	    -e 's!{{COMPILER}}!$(call SedEscape,$(call FixPath,$(CXX))) $(SYSROOT_CFLAGS)!g' \
	    -e 's!{{MAKE}}!$(call SedEscape,$(call FixPath,$(MAKE)))!g' \
	    -e 's!{{PATH}}!$(call SedEscape,$(call FixPath,$(PATH)))!g' \
	    -e 's!{{DEBUGENGINENAME}}!$(call DebugEngineName)!g' \
	    -e '/{{INDEXER_EXTENSIONS}}/d' \
	    -e '/{{INDEXER_SETTINGS}}/d' \
	    -e '/{{EXTRA_WORKSPACE_ROOT}}/d' \
	    > $2
endef

$(COMPILE_COMMANDS).tmp:
	$(foreach src, $(CPP_SOURCES), $(shell echo "{ \"directory\": \""$(PROJECT_ROOT)"\", \"file\": \""$(src)"\", \"command\": \""$(CC) -Wno-format-zero-length -c -MD $(subst $(DQUOTE),\$(DQUOTE),$(CPPFLAGS)) $(INCLUDES) $(DEFINES) $(src) -o $(src:$(PROJECT_ROOT)%.cpp=$(BUILD_DIR)/%.o)"\" }," >> $(COMPILE_COMMANDS).tmp))

$(COMPILE_COMMANDS): $(COMPILE_COMMANDS).tmp
	$(QUIETLY) sed -e '1s/^/[\$(NEWLINE)/' -e '$(DOLLAR)s/,\s\{0,\}$(DOLLAR)/\$(NEWLINE)]/' $(COMPILE_COMMANDS).tmp > $(COMPILE_COMMANDS)
	$(QUIETLY) rm $(COMPILE_COMMANDS).tmp

vscode_ccls: $(COMPILE_COMMANDS)
	$(call CreateFromTemplate, $(PROJECT_ROOT)ide/vscode/hotspot/template-workspace.jsonc, $(BUILD_DIR)/hotspot.code-workspace)

